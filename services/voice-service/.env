# Voice Service Environment Variables
# Copy this file to .env and update the values

# Server
NODE_ENV=development
PORT=3005
JWT_SECRET=stg_jwt_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5c8b1d4f7a0e3c6

# Database
MONGODB_URI=mongodb+srv://nguyenhuy6012004_db_user:nhathuy0305@cluster0.ccaayy0.mongodb.net/voice_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# External Services
USER_SERVICE_URL=http://user-service:3004
CHAT_SERVICE_URL=http://chat-service:3006
CHAT_SERVICE_DIRECT_URL=http://chat-service:3006
CHAT_INTERNAL_TOKEN=stg_chat_8e2b5d9f1a4c7e0b3d6f9a2c5e8b1d4f7a0e3c6
USER_SERVICE_INTERNAL_TOKEN=stg_user_4f7a0e3c6b9f2d5a8e1b4c7f0a3d6e9f2a5
ORGANIZATION_SERVICE_URL=http://organization-service:3013

# Cùng api-gateway / organization-service (gatewayTrust — /api/meetings)
GATEWAY_INTERNAL_TOKEN=stg_gw_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5

# Friend call 1-1: ring/accept/reject → socket-service (trùng chat-service / socket-service)
SOCKET_SERVICE_URL=http://socket-service:3017
REALTIME_INTERNAL_TOKEN=stg_rt_9c2e5b8d1f4a7c0e3b6d9f2a5c8b1e4d7f0a3
FRIEND_SERVICE_URL=http://friend-service:3014

# Voice Signaling
VOICE_SIGNAL_PATH=/voice-socket
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://voicehub.local

# Mediasoup / WebRTC
MEDIASOUP_LISTEN_IP=0.0.0.0
# Docker dev: IP WiFi LAN — chạy: powershell -File devops\scripts\sync-lan-dev-ip.ps1
# Không dùng 127.0.0.1 (Docker Desktop UDP loopback fail). Có thể nhiều IP: 172.16.x,192.168.x
MEDIASOUP_ANNOUNCED_IP=172.22.16.1,192.168.1.4
# Windows + Docker: ưu tiên ICE TCP (UDP range đôi khi vẫn lỗi qua NAT Docker).
MEDIASOUP_PREFER_TCP=true
MEDIASOUP_LOG_LEVEL=warn
MEDIASOUP_INITIAL_OUTGOING_BITRATE=1000000
RTC_MIN_PORT=40000
RTC_MAX_PORT=40065

# MinIO meeting recordings
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=voicehub_minio
MINIO_SECRET_KEY=voicehub_minio_secret_change_me
MINIO_BUCKET=meeting-recordings
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
VOICE_RECORDING_ENABLED=true
VOICE_RECORDING_OPUS_BITRATE_KBPS=16
VOICE_RECORDING_MIN_BYTES=0
VOICE_RECORDING_KEEP_PER_USER=25
VOICE_RECORDING_AUDIO_RETENTION_DAYS=7
VOICE_RECORDING_GC_INTERVAL_MS=3600000
VOICE_RECORDING_MAX_UPLOAD_MB=50
RABBITMQ_URL=amqp://voicehub:stg_rmq_6b9f2d5a8e1b4c7f0a3d6e9f2a5c8b1d4@rabbitmq-1:5672
RABBITMQ_VOICE_RECORDING_QUEUE=voice.recording.process
WHISPER_MODEL=base
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
VOICE_RECORDING_LEGACY_AUTO=false
VOICE_STT_ENABLED=true
VOICE_STT_CHUNK_SEC=20
VOICE_AI_SUMMARY_ENABLED=true
VOICE_MEETING_MIN_PERSIST_SEC=60
MIN_VOICE_RECORDING_SEC=1
RABBITMQ_VOICE_STT_QUEUE=voice.stt.chunk
RABBITMQ_VOICE_SUMMARY_QUEUE=voice.summary.process
VOICE_STT_PROVIDER=self_hosted
