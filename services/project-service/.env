# Phase 3b Time Tracking (default on; set 0 to disable)
TIME_TRACKING_V1=1

# Phase 4 Workflow Engine (default on)
WORKFLOW_ENGINE_V2=1

# Phase 5 Approval System (default on)
APPROVAL_SYSTEM_V2=1
APPROVAL_MR_RELEASE_STUB=1

# Context Call membership facts → chat-service. Rollback: PROJECT_CHAT_EVENT_PUBLISH=0
PROJECT_CHAT_EVENT_PUBLISH=true
# Project core/team channel provision → org-service
PROJECT_CHAT_CHANNELS=true

# P7 AI Resource Planning — LLM (fail-open when Ollama down)
