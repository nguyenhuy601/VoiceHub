PORT=3017
SOCKET_IO_REDIS_ADAPTER=true
REDIS_HOST=redis
REDIS_PORT=6379
# Dev: để trống để socket-service allow-all origins (phù hợp khi Vite chạy --host 0.0.0.0 và truy cập bằng IP LAN)
CORS_ORIGIN=

# URL nội bộ tới các service khác trong docker-compose
CHAT_SERVICE_URL=http://chat-service:3006
USER_SERVICE_URL=http://user-service:3004
ORGANIZATION_SERVICE_URL=http://organization-service:3013

# Phải trùng với JWT_SECRET bên auth-service và /shared
JWT_SECRET=stg_jwt_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5c8b1d4f7a0e3c6

# Trùng USER_SERVICE_INTERNAL_TOKEN trên user-service — đồng bộ online/offline khi socket connect/disconnect
USER_SERVICE_INTERNAL_TOKEN=stg_user_4f7a0e3c6b9f2d5a8e1b4c7f0a3d6e9f2a5
RABBITMQ_URL=amqp://voicehub:stg_rmq_6b9f2d5a8e1b4c7f0a3d6e9f2a5c8b1d4@rabbitmq-1:5672
