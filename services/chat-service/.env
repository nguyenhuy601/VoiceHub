#TTL file (tùy chọn)
FILE_RETENTION_DM_DAYS=180
FILE_RETENTION_ORG_DAYS=365
FILE_RETENTION_MEETING_HOURS=6
FILE_UPLOAD_MAX_MB=50

# GC Storage (cron trong chat-service)
STORAGE_GC_ENABLED=true
STORAGE_GC_INTERVAL_MS=3600000

# MIME cho phép khi xin signed URL (prefix, phân tách dấu phẩy). Thêm application/vnd.openxmlformats cho .docx/.xlsx/.pptx; application/msword cho .doc; application/octet-stream khi trình duyệt không gửi type.
FILE_ALLOWED_MIME=image/,video/,audio/,text/,application/pdf,application/rtf,application/vnd.openxmlformats,application/msword,application/vnd.ms-,application/x-msword,application/zip,application/x-zip-compressed,application/json,application/xml,application/vnd.oasis.opendocument,application/octet-stream

# Wave 3B — Meilisearch (Docker: meilisearch:7700; local dev: http://localhost:7700)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=stg_meili_7f0a3d6e9f2a5c8b1d4f7a0e3c6
MEILI_ORG_MESSAGES_INDEX=org_messages
MESSAGE_SEARCH_ENGINE=meilisearch
MESSAGE_SEARCH_INDEXER_ENABLED=true
MESSAGE_SEARCH_PUBLISH_ENABLED=true
RABBITMQ_URL=amqp://voicehub:stg_rmq_6b9f2d5a8e1b4c7f0a3d6e9f2a5c8b1d4@rabbitmq-1:5672
FRIEND_DM_USE_QUEUE=true

# # Kafka
# KAFKA_ENABLED=true
# KAFKA_BROKERS=kafka:9092
# KAFKA_CLIENT_ID=chat-service
# KAFKA_GROUP_ID=chat-domain-consumer-group
# KAFKA_TOPIC_CHAT_FRIEND_MESSAGE_SEND=chat.friend.message.send.v1
# KAFKA_TOPIC_CHAT_FRIEND_MESSAGE_CREATED=chat.friend.message.created.v1
# KAFKA_TOPIC_NOTIFICATION_DISPATCH=notification.dispatch.v1
# KAFKA_TOPIC_AUDIT_EVENT=audit.event.v1
# KAFKA_TOPIC_DEAD_LETTER=dead.letter.v1
FRIEND_SERVICE_URL=http://friend-service:3014

# Org Context Call (project_intersection visibility). Rollback: ORG_CONTEXT_CALL=0
ORG_CONTEXT_CALL=true
# Tin context hiện cả kênh. Rollback ẩn tin cũ: ORG_CONTEXT_VISIBLE_TO_ROOM=0
ORG_CONTEXT_VISIBLE_TO_ROOM=true
PROJECT_CHAT_MEMBER_CONSUMER_ENABLED=true
PROJECT_SERVICE_URL=http://project-service:3009
PROJECT_CROSS_TEAM_CONTEXT_NOTIFY=true
