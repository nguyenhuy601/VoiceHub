# Chat Service Environment Variables
# Copy this file to .env and update the values

# Server
NODE_ENV=development
PORT=3006
# Realtime canonical: socket-service /chat. Rollback legacy chat Socket.IO: CHAT_SOCKET_ENABLED=true
CHAT_SOCKET_ENABLED=false

# Database
CHAT_MONGODB_URI=mongodb+srv://nguyenhuy6012004_db_user:nhathuy0305@cluster0.ccaayy0.mongodb.net/chat_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (để verify token từ auth-service)
JWT_SECRET=stg_jwt_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5c8b1d4f7a0e3c6

# External Services
