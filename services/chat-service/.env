USER_SERVICE_INTERNAL_TOKEN=stg_user_4f7a0e3c6b9f2d5a8e1b4c7f0a3d6e9f2a5
NOTIFICATION_SERVICE_URL=http://notification-service:3003
NOTIFICATION_INTERNAL_TOKEN=stg_gw_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5
ORGANIZATION_SERVICE_URL=http://organization-service:3013
SOCKET_SERVICE_URL=http://socket-service:3017
REALTIME_INTERNAL_TOKEN=stg_rt_9c2e5b8d1f4a7c0e3b6d9f2a5c8b1e4d7f0a3

ENCRYPTION_MASTER_KEY=b1837e3abe2919701792faa053dc60865bfc48ed78a70f00b9ca314a419404ac

# Token nội bộ — friend-service gọi POST /api/messages/internal/dm/delete-between (cùng giá trị với friend-service)
CHAT_INTERNAL_TOKEN=stg_chat_8e2b5d9f1a4c7e0b3d6f9a2c5e8b1d4f7a0e3c6

# Tin x-user-id từ API Gateway (cùng api-gateway/.env)
GATEWAY_INTERNAL_TOKEN=stg_gw_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5

