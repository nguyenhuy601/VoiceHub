# ========================
# Node.js Dependencies
# ========================
node_modules/
*/node_modules/
# Giữ package-lock.json trong git — cài đặt tái lập được sau pull / npm ci trong Docker.
yarn.lock
pnpm-lock.yaml

# ========================
# Environment Variables
# ========================
# Không commit secret — chỉ giữ *.example / *.sample nếu có
.env
.env.*
!**/.env.example
!**/.env.sample
!**/.env.*.example
!devops/swarm/.env.swarm.example

# Cloudflare Origin CA (P5 — never commit)
devops/nginx/certs/cf-origin.pem
devops/nginx/certs/cf-origin-key.pem

# Ignore local docs/scripts in this workspace (keep SoT docs tracked)
docs/*
!docs/ARCHITECTURE.md
!docs/MIGRATION.md
!docs/STRUCTURE.md
!docs/LICENSE
# Local/dev generated scripts (repo-root ./scripts/; pattern also matches **/scripts/)
scripts/
# Only CI/CD devops scripts are source-controlled (un-ignore parents so Git can traverse)
!devops/
!devops/scripts/
!devops/scripts/security/
!devops/scripts/security/**
!devops/scripts/docker/
!devops/scripts/docker/**
!devops/scripts/release/
!devops/scripts/release/**

# Local analysis cache (false-positive noise for secret scanners)
.grapuco/

# ========================
# Build Outputs
# ========================
dist/
build/
*/dist/
*/build/
client/dist/
.vite/
.cache/

# ========================
# Logs
# ========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================
# IDE & Editors
# ========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ========================
# Testing
# ========================
coverage/
*.lcov
.nyc_output/
*.test.js.snap

# ========================
# OS Files
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
# Windows reserved device names (cannot be indexed by Git)
/nul
/NUL
/con
/CON
/prn
/PRN

# ========================
# Python Cache
# ========================
__pycache__/
*.pyc

# ========================
# Temporary Files
# ========================
*.tmp
*.temp
*.bak
*.backup
.cache
.temp/
# Client local build/debug dumps (redirected npm/vite/lint output)
/client/build-error.txt
/client/build-npm-*.txt
/client/lint-error.txt
/client/npm-build-verbose*.txt
/client/vite-debug.txt
/client/vite.log

# ========================
# MongoDB
# ========================
*.mongodb
mongo-data/
data/db/

# ========================
# Docker
# ========================
docker-compose.override.yml
.dockerignore

# ========================
# Misc
# ========================
*.pem
.vercel
*.tsbuildinfo

# ========================
# Local scratch / agent noise (không commit)
# ========================
/tmp/
/deep-research-report.md
/summary 1.md
devops/nginx/dev-https-runtime-*.conf
# Plan Mode local drafts (repo chỉ track vài plan đã chốt)
.cursor/plans/*.plan.md
!.cursor/plans/.gitkeep
