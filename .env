# Socket HA (S3 staging / docker-stack.yml)
SOCKET_SERVICE_REPLICAS=1
SOCKET_IO_REDIS_ADAPTER=true

# Gateway scale (P2-Gateway)
API_GATEWAY_REPLICAS=1

# Worker scale (P2-Workers — staging manual per autoscale-policy.md)
TASK_WORKER_REPLICAS=1
NOTIFICATION_DISPATCH_WORKER_REPLICAS=1
AI_TASK_EXTRACT_WORKER_REPLICAS=1
AI_TASK_SYNC_WORKER_REPLICAS=1
SUMMARY_SERVICE_REPLICAS=1
SUMMARY_WORKER_REPLICAS=1
# P2-Voice: staging single-node — UDP host 40000-40010; multi-replica cần ≥2 node voice=true
VOICE_SERVICE_REPLICAS=1

# Swarm image tag — local: voicehub-<service>:${TAG}; registry: set REGISTRY+OWNER (ghcr.io/your-org)
# Dev máy local (ổ đầy / không pull ghcr): bắt buộc 1 — tránh service Rejected "No such image"
SWARM_USE_LOCAL_IMAGES=1
REGISTRY=ghcr.io
OWNER=nguyenhuy601
IMAGE_NAME=voicehub
TAG=latest

# Feature flags (compose chỉ tham chiếu ${VAR})
FRIEND_DM_USE_QUEUE=true
BFF_CACHE_ENABLED=true
BFF_BOOTSTRAP_CACHE_TTL_SEC=45
BFF_SHELL_CACHE_TTL_SEC=60
BFF_DASHBOARD_CACHE_TTL_SEC=45
BFF_DOCUMENTS_OVERVIEW_CACHE_TTL_SEC=45
BFF_SHELL_TIMEOUT_MS=20000

# MinIO — meeting recordings (voice-service + voice-recording-worker)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=voicehub_minio
MINIO_SECRET_KEY=voicehub_minio_secret_change_me
MINIO_BUCKET=meeting-recordings
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
VOICE_RECORDING_ENABLED=true
VOICE_RECORDING_OPUS_BITRATE_KBPS=16
VOICE_RECORDING_KEEP_PER_USER=25
VOICE_RECORDING_AUDIO_RETENTION_DAYS=7
VOICE_RECORDING_GC_INTERVAL_MS=3600000
VOICE_RECORDING_MAX_UPLOAD_MB=50
VOICE_RECORDING_SKIP_TRANSCRIPT=false
RABBITMQ_VOICE_RECORDING_QUEUE=voice.recording.process
WHISPER_MODEL=base
# OLLAMA_MODEL chat = qwen2.5:3b-instruct (Ollama local, khối phía trên) — không ghi đè ở đây
OLLAMA_PLANNING_TIMEOUT_MS=240000
OLLAMA_PLANNING_ENRICH_TIMEOUT_MS=120000
AI_PLANNING_LLM=1
# Wave L — LLM WBS decompose (XOR hierarchy). Default off (HARD-02).
HOW_WBS_LLM=1
HOW_WBS_LLM_NUM_CTX=1536
HOW_WBS_LLM_TIMEOUT_MS=240000
HOW_WBS_LLM_MAX_FR=48
# Multi-leaf/FR on CPU 3B: small chunks + target 2 leaves + 240s/call
HOW_WBS_LLM_MAX_LEAVES_PER_FR=4
HOW_WBS_LLM_MAX_FR_FOR_CALL=3
HOW_WBS_LLM_MAX_CHUNKS=16
# Leave unset to auto-size predict; optional override:
# HOW_WBS_LLM_NUM_PREDICT=320
# Reuse identical Ollama responses (Mongo + Redis); skip 2nd call for same prompt hash
HOW_WBS_LLM_CACHE=1
HOW_WBS_LLM_CACHE_TTL_SEC=604800
HOW_WBS_TOOL_TIMEOUT_MS=900000
# G4 semantic pipeline (APS) — AI_G4_PIPELINE=0 rolls back to legacy chunk×wall
AI_G4_PIPELINE=1
AI_G4_MAX_FR=200
AI_G4_SEMANTIC_TIMEOUT_MS=45000
AI_G4_SEMANTIC_MAX_INPUT_TOKENS=1400
AI_G4_SEMANTIC_MAX_OUTPUT_TOKENS=256
AI_G4_SEMANTIC_MAX_CALLS=1
AI_G4_SEMANTIC_MAX_PROMPT_CHARS=10000
AI_G4_CONFLICT_TIMEOUT_MS=45000
AI_G4_SYNTHESIS_TIMEOUT_MS=45000
AI_G4_SYNTHESIS_MAX_OUTPUT_TOKENS=384
AI_G4_CONTINUE_ON_TIMEOUT=1
AI_G4_EVIDENCE_REQUIRED=1
AI_PLANNING_STAFFING_SPLIT=1
VOICE_RECORDING_LEGACY_AUTO=false
VOICE_STT_ENABLED=true
VOICE_STT_CHUNK_SEC=20
VOICE_AI_SUMMARY_ENABLED=true
VOICE_MEETING_MIN_PERSIST_SEC=60
MIN_VOICE_RECORDING_SEC=1
RABBITMQ_VOICE_STT_QUEUE=voice.stt.chunk
RABBITMQ_VOICE_SUMMARY_QUEUE=voice.summary.process
VOICE_STT_PROVIDER=self_hosted

# Single-company pivot (1 instance = 1 công ty)
SINGLE_ORG_MODE=true
ALLOW_PUBLIC_REGISTER=false
SEED_COMPANY_NAME="VoiceHub Company"
SEED_COMPANY_SLUG=voicehub-company
SEED_ADMIN_EMAIL=admin@voicehub.local
SEED_ADMIN_PASSWORD=Admin@123456
GATEWAY_URL=http://localhost:3000
GATEWAY_PROXY_TIMEOUT_MS=300000
ASSIGNMENT_ENGINE_V1=true


# Wave1 B — Understanding only (rollback: HITL_AUTO_WHAT=1)
HITL_AUTO_WHAT=0
AUTO_WHAT_CONFIRM=0

# Phase1 tool-first Stage2 LLM projection (0 = heuristic only)
PHASE1_TOOLS_PROPOSE=1

# Customer Raw → derive Analysis sections (UC/BG/BR/…) from pack; 0 = kill-switch (sheet-empty SKIP)
PHASE1_RAW_SECTION_DERIVE=1
PHASE1_RAW_DERIVE_SECTIONS=bg,br,uc,bpm,data,interface
PHASE1_RAW_DERIVE_DETERMINISTIC=scope,actors,assumption
PHASE1_BG_BRQ_SEED=0
PHASE1_BG_BRQ_SEED_MIN=2
PHASE1_BG_DERIVE_MAX_TOKENS=448
PHASE1_BR_DERIVE_MAX_TOKENS=400
PHASE1_UC_DERIVE_MAX_TOKENS=400
PHASE1_BPM_DERIVE_MAX_TOKENS=320
PHASE1_DATA_DERIVE_MAX_TOKENS=256
PHASE1_INTERFACE_DERIVE_MAX_TOKENS=256
PHASE1_DATA_GROUNDED_FIRST=1
PHASE1_INTERFACE_GROUNDED_FIRST=1
PHASE1_UC_GROUNDED_FIRST=1
PHASE1_BPM_GROUNDED_FIRST=1
PHASE1_DERIVE_NUM_CTX=2048

# Phase1 Part2 knowledge stub (0 = disable citations in projection)
PHASE1_KNOWLEDGE_STUB=1

# Phase1 evidence A/B/C
PHASE1_REQUIRE_EVIDENCE=1
PHASE1_GROUNDING_MODE=drop
PHASE1_GROUNDING_THRESHOLD=0.15
PHASE1_RAG=stub

HOW_WBS_LLM_QUEUE=1
HOW_WBS_LLM_JOB_TIMEOUT_MS=1800000
HOW_WBS_LLM_JOB_STALE_MS=1900000
