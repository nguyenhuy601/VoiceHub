# API Gateway Environment Variables
# Copy this file to .env and update the values

# Server
NODE_ENV=production
PORT=3000

# JWT Secret (phải giống với auth-service)
JWT_SECRET=stg_jwt_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5c8b1d4f7a0e3c6

# Microservices URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3004
FRIEND_SERVICE_URL=http://friend-service:3014
ORGANIZATION_SERVICE_URL=http://organization-service:3013
ROLE_PERMISSION_SERVICE_URL=http://role-permission-service:3015
CHAT_SERVICE_URL=http://chat-service:3006
VOICE_SERVICE_URL=http://voice-service:3005
PROJECT_SERVICE_URL=http://project-service:3009
TASK_SERVICE_URL=http://project-service:3009
DOCUMENT_SERVICE_URL=http://document-service:3010
NOTIFICATION_SERVICE_URL=http://notification-service:3003
SOCKET_SERVICE_URL=http://socket-service:3017
VOICE_SIGNAL_PATH=/voice-socket
SUMMARY_SERVICE_URL=http://summary-service:3021

# Docker: cũng có trong root .env (trùng giá trị). Chạy node local chỉ trong thư mục api-gateway thì cần dòng này.
GATEWAY_INTERNAL_TOKEN=stg_gw_a7f3c9e2b18d4f6a0e5c8b2d9f1a4e7c0b3d6f9a2e5
TRUST_PROXY=1

# BFF — documents-overview gom chat search (mặc định gateway chỉ 7s → ECONNABORTED)
BFF_DOCUMENTS_OVERVIEW_TIMEOUT_MS=45000

# Browser origins (production / test CORS). Dev NODE_ENV=development vẫn cho phép mọi origin.
CORS_ORIGIN=https://voicehub.local,http://localhost:5173,http://127.0.0.1:5173

AI_TASK_SERVICE_URL=http://ai-task-service:3020

# Swagger / OpenAPI
# - Hard-off production trừ khi SWAGGER_ALLOW_IN_PRODUCTION=1 (LAN/staging Swarm)
# - Tắt hẳn: SWAGGER_ENABLED=0
SWAGGER_ENABLED=1
SWAGGER_ALLOW_IN_PRODUCTION=1
SWAGGER_LIVE_SCAN=0
# SWAGGER_API_VERSION=1.0.0
# SWAGGER_CONTACT_NAME=VoiceHub Team
# SWAGGER_CONTACT_EMAIL=
# SWAGGER_LICENSE_NAME=ISC
# SWAGGER_SERVER_URL=
