{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway - Entry point cho tất cả microservices",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "openapi:build": "node scripts/run-openapi-build.cjs",
    "openapi:lint": "node scripts/run-openapi-lint.cjs",
    "test": "node --test src/swagger/*.test.js",
    "postinstall": "node ../shared/postinstall-link.cjs"
  },
  "keywords": [
    "api-gateway",
    "microservices",
    "proxy",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.10.1",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "protobufjs": "7.6.1",
    "websocket-driver": "0.7.5",
    "fast-xml-parser": "5.5.6",
    "fast-xml-builder": "1.1.7",
    "tar": "7.5.21",
    "@grpc/grpc-js": "1.14.5",
    "engine.io": "6.6.10",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.0",
    "@fastify/busboy": "3.2.1",
    "minimatch@3": "3.1.4",
    "brace-expansion@1": "1.1.20",
    "brace-expansion@2": "2.1.6",
    "path-to-regexp@0.1.12": "0.1.13",
    "path-to-regexp@8": "8.4.0",
    "form-data@2": "2.5.6",
    "form-data@4": "4.0.6",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4"
  }
}
